{
  "name": "@pgpjs/cli",
  "version": "0.1.0",
  "description": "Official developer CLI and project bootstrapper for PGPJS",
  "type": "module",
  "bin": {
    "pgpjs": "./bin/pgpjs.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pgpjs/core": "*"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  }
}